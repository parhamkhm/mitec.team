# Copy to .env and fill in. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API with credentials
# (the site's real origin(s), e.g. https://mitec.team,https://www.mitec.team).
# For local dev against devserver.py:
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://mitec:mitec@127.0.0.1:5432/mitec

# --- Admin auth ---
# Used once by `npm run seed:admin` to create the first account(s).
# Comma-separated pairs of username:password to seed, e.g. "sina:changeme,parham:changeme2".
ADMIN_SEED_ACCOUNTS=sina:changeme
# Long random string used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
# true when the API is served over HTTPS in production (sets the Secure cookie flag)
COOKIE_SECURE=false

# --- Uploads ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=8
UPLOAD_MAX_FILES=5
# Comma-separated MIME types, must match project/src/config/app.config.js `upload.accept`
UPLOAD_ACCEPT=image/png,image/jpeg,image/webp,application/pdf

# --- Order notification email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="mitec <no-reply@mitec.team>"
# Comma-separated recipient list (the team).
MAIL_TO=
