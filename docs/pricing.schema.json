{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mitec.team/schemas/pricing.schema.json",
  "title": "mitec pricing document",
  "description": "The single data document behind the home page's quick-scope calculator and, later, the /order wizard. The admin panel edits it; the front end only renders it (GET /pricing). Prices are tomans, durations are working days, both integers >= 0.",
  "$comment": "Three rules cannot be expressed in standard JSON Schema and MUST be checked in code by the back end (the front end also tolerates them defensively): see x-rules at the end of this document.",

  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "placeholder", "currency", "display", "section", "siteTypes", "addons"],
  "properties": {
    "version": {
      "description": "Increases by one on every saved change. PUT /admin/pricing must send the version it loaded; a stale one is rejected with 409.",
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "placeholder": {
      "description": "true while the numbers are samples. The site shows a «sample numbers» badge next to the section heading.",
      "type": "boolean"
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "divisor", "suffix", "from"],
      "properties": {
        "unit": { "description": "Shown after amounts below one divisor, e.g. «۸۵۰٬۰۰۰ تومان».", "type": "string", "minLength": 1 },
        "divisor": { "description": "Amounts at or above this are shown divided by it, e.g. 1000000 for «میلیون».", "type": "integer", "minimum": 1 },
        "suffix": { "description": "Shown after divided amounts, e.g. «۲۴ میلیون تومان».", "type": "string", "minLength": 1 },
        "from": { "description": "Prefix meaning «from / starting at», e.g. «از».", "type": "string" }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showPrice", "showDuration", "durationUnit", "durationLabel", "durationPrefix"],
      "properties": {
        "showPrice": { "description": "false removes every price from the page (not hidden: not rendered).", "type": "boolean" },
        "showDuration": { "description": "false removes the duration from the page.", "type": "boolean" },
        "durationUnit": { "description": "What `days` counts.", "enum": ["workday"] },
        "durationLabel": { "description": "The unit's label, e.g. «روز کاری».", "type": "string", "minLength": 1 },
        "durationPrefix": { "description": "Words before the number, e.g. «حدود».", "type": "string" }
      }
    },
    "section": {
      "description": "Every string the section shows. Templates use {n} for a number.",
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "subtitle", "ctaLabel", "disclaimer", "placeholderBadge", "typesLabel", "pagesIncluded", "pagesTitle", "pagesDesc", "pagesValue", "addonsTitle", "showAll", "totalLabel"],
      "properties": {
        "eyebrow": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "subtitle": { "type": "string" },
        "ctaLabel": { "$ref": "#/$defs/text" },
        "disclaimer": { "type": "string" },
        "placeholderBadge": { "$ref": "#/$defs/text" },
        "typesLabel": { "description": "Accessible name of the site-type tabs.", "$ref": "#/$defs/text" },
        "pagesIncluded": { "description": "Base card footer, e.g. «شامل {n} صفحه».", "$ref": "#/$defs/template" },
        "pagesTitle": { "$ref": "#/$defs/text" },
        "pagesDesc": { "type": "string" },
        "pagesValue": { "description": "The slider's value, e.g. «{n} صفحه».", "$ref": "#/$defs/template" },
        "addonsTitle": { "$ref": "#/$defs/text" },
        "showAll": { "description": "Phone-only button that expands the base items.", "$ref": "#/$defs/text" },
        "totalLabel": { "$ref": "#/$defs/text" }
      }
    },
    "siteTypes": {
      "description": "One package per site type. The order catalog's «unsure» is not a package; the section links it to the order builder.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/siteType" },
      "x-uniqueBy": "id"
    },
    "addons": {
      "description": "Defined once here and referenced by id from each site type, so a price is edited in one place.",
      "type": "array",
      "items": { "$ref": "#/$defs/addon" },
      "x-uniqueBy": "id"
    }
  },

  "$defs": {
    "id": { "description": "A stable slug. Labels may change freely; ids should not.", "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "template": { "type": "string", "pattern": "\\{n\\}" },
    "toman": { "description": "Tomans, whole number.", "type": "integer", "minimum": 0 },
    "days": { "description": "Working days, whole number.", "type": "integer", "minimum": 0 },
    "order": { "description": "Sort position, ascending.", "type": "integer", "minimum": 0 },

    "includedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "desc": { "type": "string" }
      }
    },

    "siteType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "active", "order", "base", "pages", "addons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "active": { "description": "false hides the type without deleting it.", "type": "boolean" },
        "order": { "$ref": "#/$defs/order" },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "price", "days", "pagesIncluded", "included"],
          "properties": {
            "title": { "$ref": "#/$defs/text" },
            "subtitle": { "type": "string" },
            "price": { "$ref": "#/$defs/toman" },
            "days": { "$ref": "#/$defs/days" },
            "pagesIncluded": { "description": "Pages the base price covers.", "type": "integer", "minimum": 1 },
            "included": {
              "description": "What every project of this type includes.",
              "type": "array",
              "items": { "$ref": "#/$defs/includedItem" },
              "x-uniqueBy": "id"
            }
          }
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "min", "max", "pricePerExtra", "daysPerExtra"],
          "properties": {
            "enabled": { "description": "false hides the page slider for this type; the base pages apply.", "type": "boolean" },
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 },
            "pricePerExtra": { "$ref": "#/$defs/toman" },
            "daysPerExtra": { "$ref": "#/$defs/days" }
          },
          "x-rule": "min <= max"
        },
        "addons": {
          "description": "Ids of add-ons offered for this type, in any order (the add-on's own `order` sorts them).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id", "x-refersTo": "#/addons/*/id" }
        }
      }
    },

    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "price", "days", "active", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "desc": { "type": "string" },
        "price": { "description": "0 shows no price on the row.", "$ref": "#/$defs/toman" },
        "days": { "$ref": "#/$defs/days" },
        "active": { "description": "false hides the add-on everywhere without deleting it.", "type": "boolean" },
        "order": { "$ref": "#/$defs/order" }
      }
    }
  },

  "x-rules": [
    "siteTypes[].id, addons[].id and each siteTypes[].base.included[].id must be unique within their array (marked x-uniqueBy).",
    "siteTypes[].pages.min must be <= siteTypes[].pages.max (marked x-rule).",
    "Every id in siteTypes[].addons must be the id of an entry in addons[] (marked x-refersTo).",
    "There is no logo / branding add-on: mitec does not design brands (see the FAQ)."
  ]
}
